<?xml version="1.0"?>
<!--
  arm: 4-joint desktop arm - base yaw, shoulder pitch (20:1 cycloidal drive), elbow pitch and
  wrist pitch (GT2 belts) - + NEMA17-pancake wrist roll + MG996R parallel gripper. Three joints
  are driven by MKS SERVO42D steppers (src/config.py J1..J3; which drives which is unconfirmed).

  SOURCE OF TRUTH: this file. Every number is derived from the CAD by cad/tools/robot/derive.py
  (cad/robot/frames.py = link partition + joint frames; cad/reference/placements.json = the
  SolidWorks capture) and verified with `./cadtool python tools/robot/derive.py`, check mode
  (tests/test_robot.py runs it). Regenerate meshes with cad/tools/robot/export_link_meshes.py.

  FRAMES (REP-103): base_link on the base's bottom face at the base_yaw axis, Z up, X forward
  (the direction the arm extends). Every joint frame has Z on the joint axis and X along the
  child link's long direction at the capture pose. A child link's frame IS its joint frame at
  the SolidWorks capture pose: ALL JOINTS ARE 0 AT THE CAPTURE POSE and every mesh origin is
  identity. In that pose shoulder_link is yawed +3.694 deg about base_yaw relative to base X (a
  captured pose, not a design offset); the shoulder_pitch, elbow_pitch and wrist_pitch axes are
  parallel (210.0 mm apart each in the pitch plane, with 10 mm and 42 mm offsets along the axis).

  UNITS: metres, kilograms, radians. MESHES: meshes/<link>.stl in millimetres (scale 0.001),
  one per link in the link frame (visual and collision reuse them; simplified collision
  primitives are a TODO). INERTIALS: OCP BRepGProp on the CAD solids, printed parts at PETG
  1.27 g/cm3, purchased parts at their datasheet/estimated mass (cad/lib/params.py).

  PLACEHOLDERS [ESTIMATE] (cad/lib/params.py): all limits, effort and velocity values; the
  positive-motion sign of every axis (confirm with viewer sweeps); jaw travel range.
  ASSUMPTIONS: j1_coupler (the holder) turns on the base and carries the cycloidal drive's
  stator (housing, motor, gear train) in its yoke - together shoulder_link; the drive's rotor
  (output hub + pins) is bolted to j1_link - with j1_cap, upper_arm_link - so the drive IS the
  shoulder_pitch joint (cad/docs/cycloidal_drive.md, cad/assemblies/cycloidal_drive.py BODIES);
  the GT2 90T pulleys + J3 couplers are bolted to the driven links (forearm_link at elbow_pitch,
  wrist_pitch_link at wrist_pitch); the MG996R crank linkage is merged into wrist_roll_link;
  jaw_b mirrors jaw_a (mimic, multiplier -1); positive jaw_a = opening.
  UNCONFIRMED: which MKS motor (src/config.py J1..J3) drives which joint - the shoulder_pitch
  motor is the drive's own NEMA 17 at 20:1 (cad/lib/params.py CYCLOIDAL_RATIO; src/config.py
  still carries gear_ratio 1.0 everywhere). wrist_roll and the jaws are not driven by src/config.py.
-->
<robot name="arm">
  <link name="base_link">
    <inertial>
      <origin xyz="-0.023537 -0.000065 0.054693" rpy="0 0 0" />
      <mass value="0.363435" />
      <inertia ixx="8.183245e-04" ixy="6.639409e-07" ixz="-1.629800e-04" iyy="1.305486e-03" iyz="9.081833e-08" izz="1.532189e-03" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/base_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/base_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <link name="shoulder_link">
    <inertial>
      <origin xyz="-0.000726 0.013853 -0.011441" rpy="0 0 0" />
      <mass value="1.629416" />
      <inertia ixx="3.663759e-03" ixy="3.487923e-06" ixz="1.260652e-05" iyy="3.561365e-03" iyz="-2.610875e-04" izz="2.701054e-03" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/shoulder_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/shoulder_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <link name="upper_arm_link">
    <inertial>
      <origin xyz="0.088378 0 -0.008608" rpy="0 0 0" />
      <mass value="0.786378" />
      <inertia ixx="8.468129e-04" ixy="-1.259123e-08" ixz="4.683250e-04" iyy="6.275076e-03" iyz="3.607455e-09" izz="6.660124e-03" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/upper_arm_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/upper_arm_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <link name="forearm_link">
    <inertial>
      <origin xyz="0.097142 0.000002 0.010186" rpy="0 0 0" />
      <mass value="0.684302" />
      <inertia ixx="7.271294e-04" ixy="-6.577201e-08" ixz="-2.825096e-04" iyy="5.606360e-03" iyz="-2.817914e-09" izz="6.007771e-03" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/forearm_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/forearm_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <link name="wrist_pitch_link">
    <inertial>
      <origin xyz="0.060735 0.000068 -0.014763" rpy="0 0 0" />
      <mass value="0.440548" />
      <inertia ixx="2.099885e-04" ixy="-7.021730e-07" ixz="4.137442e-05" iyy="8.819831e-04" iyz="5.963427e-08" izz="9.360178e-04" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/wrist_pitch_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/wrist_pitch_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <link name="wrist_roll_link">
    <inertial>
      <origin xyz="0.000012 -0.008443 0.053776" rpy="0 0 0" />
      <mass value="0.16664" />
      <inertia ixx="1.259933e-04" ixy="-1.888508e-09" ixz="3.634024e-08" iyy="1.739991e-04" iyz="1.495119e-05" izz="1.150603e-04" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/wrist_roll_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/wrist_roll_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <link name="jaw_a_link">
    <inertial>
      <origin xyz="0.021644 0 -0.001923" rpy="0 0 0" />
      <mass value="0.058661" />
      <inertia ixx="7.006318e-06" ixy="2.243133e-13" ixz="3.571123e-06" iyy="6.252591e-05" iyz="-3.357013e-13" izz="6.325509e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/jaw_a_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/jaw_a_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <link name="jaw_b_link">
    <inertial>
      <origin xyz="0.021643 0.000001 0.001924" rpy="0 0 0" />
      <mass value="0.058661" />
      <inertia ixx="7.006321e-06" ixy="1.955510e-12" ixz="-3.571150e-06" iyy="6.252591e-05" iyz="-7.337480e-14" izz="6.325509e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/jaw_b_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/jaw_b_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <link name="tool0" />
  <joint name="base_yaw" type="revolute">
    <parent link="base_link" />
    <child link="shoulder_link" />
    <origin xyz="0 0 0.18591" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.054326" upper="3.054326" effort="5" velocity="1" />
  </joint>
  <joint name="shoulder_pitch" type="revolute">
    <parent link="shoulder_link" />
    <child link="upper_arm_link" />
    <origin xyz="0.002441 -0.034915 0" rpy="-1.570796 -0.830504 0.064484" />
    <axis xyz="0 0 1" />
    <limit lower="-2.094395" upper="2.094395" effort="5" velocity="1" />
  </joint>
  <joint name="elbow_pitch" type="revolute">
    <parent link="upper_arm_link" />
    <child link="forearm_link" />
    <origin xyz="0.210003 0 0.009998" rpy="0 0 0.010227" />
    <axis xyz="0 0 1" />
    <limit lower="-2.094395" upper="2.094395" effort="5" velocity="1" />
  </joint>
  <joint name="wrist_pitch" type="revolute">
    <parent link="forearm_link" />
    <child link="wrist_pitch_link" />
    <origin xyz="0.21 0 0.041998" rpy="0 0 0.299075" />
    <axis xyz="0 0 1" />
    <limit lower="-2.094395" upper="2.094395" effort="5" velocity="1" />
  </joint>
  <joint name="wrist_roll" type="revolute">
    <parent link="wrist_pitch_link" />
    <child link="wrist_roll_link" />
    <origin xyz="0.109643 0.000005 -0.016998" rpy="-1.570799 -0.055534 -1.570796" />
    <axis xyz="0 0 1" />
    <limit lower="-3.141593" upper="3.141593" effort="1" velocity="2" />
  </joint>
  <joint name="jaw_a" type="prismatic">
    <parent link="wrist_roll_link" />
    <child link="jaw_a_link" />
    <origin xyz="-0.053464 0 0.05495" rpy="0 -1.570796 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.01" upper="0.01" effort="20" velocity="0.05" />
  </joint>
  <joint name="jaw_b" type="prismatic">
    <parent link="wrist_roll_link" />
    <child link="jaw_b_link" />
    <origin xyz="0.053465 -0.000001 0.054951" rpy="0 -1.570796 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.01" upper="0.01" effort="20" velocity="0.05" />
    <mimic joint="jaw_a" multiplier="-1" offset="0" />
  </joint>
  <joint name="tool0_joint" type="fixed">
    <parent link="wrist_roll_link" />
    <child link="tool0" />
    <origin xyz="-0.000001 0 0.116951" rpy="0 0 0" />
  </joint>
</robot>
