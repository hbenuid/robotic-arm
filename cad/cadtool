#!/usr/bin/env bash
# cadtool - the one entry point for cad/: the cadgen 0.8 toolchain (a model is a plain script you
# RUN: this venv's warm cadgen engine builds it and writes the file its @step declares; every other verb is
# the `cadgen` console script) plus the usual dev commands, all inside THIS uv project (Python 3.12 +
# build123d + cadgen), always from cad/ with PYTHONPATH=cad/ so `lib`, `parts`, `assemblies` and `robot`
# import the same way for you and for the engine's workers. Only `parts`, `skill` and `doctor` need the
# text-to-cad@earthtojake plugin itself (CAD_PLUGIN=<dir> overrides its auto-detection).
set -euo pipefail

usage() {
  cat <<'USAGE'
cadtool - cadgen 0.8 + this uv project (paths relative to cad/)
  ./cadtool setup                                   per machine: uv sync, bytecode compiled (+ the OCP kernel check) + the git pre-commit hook (ruff)
                                                    + git notes fetching + cadgen's telemetry stored off
  ./cadtool doctor                                 the venv's cadgen vs the plugin's pin, the OCP kernel, this venv's engine
  ./cadtool gen <model.py>... [--force]             build: run the model script(s) -> the sibling <name>.step (an assembly's
                                                    children write theirs too); a current one says "took ... nothing ran" and
                                                    keeps its file; --force runs every kernel call again (CADGEN_ENGINE_MEMO=0)
  ./cadtool step ...                                alias of gen
  ./cadtool inspect <file.step> [--planes] [--json] every leaf's ref, solids, faces, volume, bbox of a saved STEP
                                                    (--planes: + every planar face as normal / offset / area)
  ./cadtool inspect diff <a.step> <b.step> [--tol X] same geometry? (exit 1 if not) - a LOCAL tool, tools/step_facts.py
  ./cadtool cadgen inspect <file.step|id> ["<ref>"]  what a document holds, or what one ref names (cadgen's own)
  ./cadtool snapshot <file.step|.urdf|.sdf|.stl|id> <out.png> [--size-profile assembly --camera iso --display ... --job job.json]
                                                    the path you name is the file you get
  ./cadtool export <file.step> stl|3mf|glb [out]    one mesh file per call (default: <file>.<format> beside it)
  ./cadtool validate <file.urdf|.srdf|.sdf> [--strict] [--gz-check never]
  ./cadtool viewer [file|id ...]                    this venv's engine opens each on its page, /<id> (default assemblies/arm.step);
                                                    the link printed is good for a day, the engine serves until ./cadtool stop
  ./cadtool status                                  this venv's engine: its workers, the documents it holds, its port, its cache
  ./cadtool stop                                    stop this venv's engine (the next gen / viewer starts a fresh one): after a
                                                    pyproject.toml / uv.lock change, and when leaving a worktree
  ./cadtool parts "<query>" [--download] [--id <id>] [--filename <name>.step]   step.parts search / download into vendor/
  ./cadtool skill <skill> <tool> [args]             a plugin skill script: skills/<skill>/scripts/<tool>
                                                    (+ the skill's requirements.txt, unlocked, in uv's cache)
  ./cadtool cadgen ...                              any cadgen subcommand (`./cadtool cadgen --help`)
  ./cadtool pytest [-m "not slow"] [-n 4]           test suite (-n: worker processes, a whole test file each)
  ./cadtool lint [--fix] [path...]                  ruff check (lint only, no formatter; rules: pyproject.toml [tool.ruff])
  ./cadtool python -m assemblies.arm ...            any python in the venv (PYTHONPATH=cad/)
  ./cadtool clean [--all]                           delete __pycache__/, .pytest_cache/, .ruff_cache/ (and any stray __cadgen__/);
                                                    --all also empties snapshots/ and print/ and deletes
                                                    assemblies/*.step, robot/links/*.step
Retired with cadgen 0.8 (each says what replaced it): why, compile, store, daemon.
Env: CAD_PLUGIN=<plugin dir> overrides detection. cadgen 0.8's document cache: ~/.cache/cadgen/documents
     (CADGEN_CACHE_DIR moves it; ./cadtool cadgen delete <id> removes one).
USAGE
}

CAD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$CAD_DIR"   # cadgen resolves targets from cwd
export PYTHONPATH="$CAD_DIR${PYTHONPATH:+:$PYTHONPATH}"
# No __pycache__/ written into the tree (pytest importing every part would leave one in each group folder).
export PYTHONDONTWRITEBYTECODE=1
# cadgen sends usage stats and crash reports by default once a cadgen command has shown its notice; this repo keeps
# them off. In the environment, no cadtool command shows the notice or sends anything; `setup` also stores the "off"
# that what cadtool does not start (the plugin's MCP server and its engine) goes by.
export CADGEN_TELEMETRY=0

cadgen_version() { uv run --frozen cadgen --version 2>/dev/null | awk '{print $NF}'; }

plugin_dir() {  # the plugin cache entry whose version matches the venv's cadgen, else the newest (warned)
  local cache="$HOME/.claude/plugins/cache/earthtojake/text-to-cad" ver newest
  ver="$(cadgen_version || true)"
  if [[ -n "$ver" && -d "$cache/$ver" ]]; then echo "$cache/$ver"; return; fi
  newest="$(ls -d "$cache"/*/ 2>/dev/null | sort -V | tail -1 || true)"; newest="${newest%/}"
  [[ -n "$newest" ]] && echo "cadtool: warning: no plugin cache for cadgen ${ver:-?}; using $newest" >&2
  echo "$newest"
}

CAD_PLUGIN="${CAD_PLUGIN:-}"
need_plugin() {
  [[ -n "$CAD_PLUGIN" ]] || CAD_PLUGIN="$(plugin_dir)"
  if [[ -z "$CAD_PLUGIN" || ! -d "$CAD_PLUGIN/skills" ]]; then
    echo "cadtool: text-to-cad@earthtojake plugin not found under ~/.claude/plugins/cache/earthtojake" >&2
    echo "  install:  claude plugin marketplace add https://github.com/earthtojake/text-to-cad.git" >&2
    echo "            claude plugin install text-to-cad@earthtojake" >&2
    echo "  (a machine with the old cad@text-to-cad switches once: docs/toolchain.md Gotchas)" >&2
    exit 1
  fi
}

run_skill() {  # run_skill <skill> <tool> [args...]  ->  python skills/<skill>/scripts/<tool> args
  local skill="$1" tool="$2"; shift 2
  need_plugin
  local target="$CAD_PLUGIN/skills/$skill/scripts/$tool"
  if [[ ! -e "$target" ]]; then
    echo "cadtool: no such plugin tool: $target" >&2
    exit 1
  fi
  # The skill's own libraries (dfam-check / dfm: trimesh, rtree, scipy ...) ride in uv's cached overlay for
  # this run, never in this project's lock. A requirements file that pins cadgen is left out: this venv's
  # cadgen IS that pin (`./cadtool doctor`), and resolving it afresh could pull a second cadgen + kernel.
  local reqs="$CAD_PLUGIN/skills/$skill/requirements.txt" with=()
  if [[ -f "$reqs" ]] && ! grep -q '^cadgen' "$reqs"; then with=(--with-requirements "$reqs"); fi
  exec uv run --frozen ${with[@]+"${with[@]}"} python "$target" "$@"
}

cg() { exec uv run --frozen cadgen "$@"; }

install_git_hook() {  # .git/hooks/pre-commit = a stub that runs the committed ../.githooks/pre-commit (ruff on the staged
  # .py files).
  local hooks stub marker="installed by cad/cadtool setup"
  hooks="$(git rev-parse --git-path hooks)" || return 0
  stub="$hooks/pre-commit"
  if [[ -e "$stub" ]] && ! grep -q "$marker" "$stub"; then
    echo "cadtool: $stub exists and is not ours - left alone (the ruff pre-commit hook is NOT installed)" >&2
    return 0
  fi
  mkdir -p "$hooks"
  printf '%s\n' '#!/bin/sh' "# $marker: the hook itself is the committed .githooks/pre-commit" \
    'exec bash "$(git rev-parse --show-toplevel)/.githooks/pre-commit" "$@"' > "$stub"
  chmod +x "$stub"
  echo "cadtool: git pre-commit hook installed ($stub -> .githooks/pre-commit)"
}

fetch_git_notes() {  # the retired CHANGELOG.md lives on as git notes (refs/notes/commits) - `git log` shows them.
  # Notes are not fetched by default: add the refspec once per machine. Not forced (+): a divergent notes ref fails the
  # fetch loudly instead of silently replacing local notes.
  local spec='refs/notes/*:refs/notes/*' have
  have="$(git config --get-all remote.origin.fetch 2>/dev/null || true)"
  case "$have" in *"$spec"*) return 0 ;; esac
  git config --add remote.origin.fetch "$spec" || return 0
  git fetch --quiet origin || echo "cadtool: git fetch of the notes failed - run 'git fetch origin' by hand" >&2
  echo "cadtool: git notes now come with every fetch / pull (remote.origin.fetch += $spec)"
}

cmd="${1:-help}"
shift || true
case "$cmd" in
  gen|step)
    # A cadgen 0.8 run takes no options: --force is the engine's no-memo switch, any other flag is refused here.
    files=(); force=0
    for a in "$@"; do
      case "$a" in
        *.py) files+=("$a") ;;
        --force) force=1 ;;
        *) echo "cadtool gen: '$a' - a cadgen 0.8 run takes no options (--force: CADGEN_ENGINE_MEMO=0)" >&2; exit 2 ;;
      esac
    done
    if [[ ${#files[@]} -eq 0 ]]; then echo "usage: cadtool gen <model.py>... [--force]" >&2; exit 2; fi
    if [[ $force -eq 1 ]]; then export CADGEN_ENGINE_MEMO=0; fi
    for f in "${files[@]}"; do uv run --frozen python "$f"; done ;;
  why|compile|store|daemon)
    case "$cmd" in
      why) said="no staleness check: run the model (./cadtool gen) - 'took ... nothing ran' is current, 'rebuilt: ...' says what changed" ;;
      compile) said="nothing to compile: the engine reads a STEP as it is" ;;
      store) said="no store: ./cadtool status (the engine, its documents, its cache), ./cadtool cadgen delete <id>" ;;
      *) said="one engine per venv: ./cadtool status, ./cadtool stop" ;;
    esac
    echo "cadtool $cmd: retired with cadgen 0.8 - $said" >&2; exit 2 ;;
  inspect)
    exec uv run --frozen python tools/step_facts.py "$@" ;;
  snapshot)
    cg snapshot "$@" ;;
  export)
    doc="${1:?usage: cadtool export <file.step> stl|3mf|glb [out]}"; fmt="${2:?usage: cadtool export <file.step> stl|3mf|glb [out]}"; shift 2
    case "$fmt" in stl|3mf|glb) ;; *) echo "cadtool: export format must be stl|3mf|glb (got '$fmt')" >&2; exit 2 ;; esac
    cg export "$doc" "${1:-${doc%.*}.$fmt}" ;;
  validate)
    file="${1:-}"
    case "$file" in
      *.urdf) cg urdf validate "$@" ;;
      *.srdf) cg srdf validate "$@" ;;
      *.sdf)  cg sdf validate "$@" ;;
      *) echo "usage: cadtool validate <file.urdf|.srdf|.sdf> [--strict] [--gz-check never] [--json]" >&2; exit 2 ;;
    esac ;;
  viewer)
    # This venv's engine (started when none runs; no timer stops it: ./cadtool stop) registers each file / document
    # id and opens its page, /<id>; the printed link is good for a day.
    if [[ $# -eq 0 ]]; then set -- assemblies/arm.step; fi
    cg viewer "$@" ;;
  status)
    cg status "$@" ;;
  stop)
    cg stop "$@" ;;
  cadgen)
    cg "$@" ;;
  parts)
    run_skill step-parts download_step_part.py --out-dir "$CAD_DIR/vendor" "$@" ;;
  skill)
    skill="${1:?usage: cadtool skill <skill> <tool> [args]}"; tool="${2:?usage: cadtool skill <skill> <tool> [args]}"; shift 2
    run_skill "$skill" "$tool" "$@" ;;
  doctor)
    # Not `cadgen doctor`: run here it would register THIS venv as the machine's cadgen installation of its version (the
    # record the `cadgen` command and the plugin's skills run by - docs/toolchain.md Gotchas) and start its engine.
    rc=0
    need_plugin
    ver="$(cadgen_version || true)"
    pin="$(grep -o -m1 'cadgen==[0-9][0-9.]*' "$CAD_PLUGIN/claude.mcp.json" || true)"; pin="${pin#cadgen==}"
    if [[ -n "$ver" && "$ver" == "$pin" ]]; then echo "cadgen $ver: the plugin's pin   ($CAD_PLUGIN)"
    else echo "cadgen ${ver:-?} in the venv, the plugin pins ${pin:-?}   ($CAD_PLUGIN): MISMATCH - docs/toolchain.md Pins"; rc=1; fi
    if uv run --frozen python -c "import OCP.gp" 2>/dev/null; then echo "kernel: OCP imports"
    else echo "kernel: OCP.gp does not import - run ./cadtool setup"; rc=1; fi
    uv run --frozen cadgen status 2>&1 | head -1 || true
    exit $rc ;;
  setup)
    # Bytecode compiled into .venv (never into cad/: PYTHONDONTWRITEBYTECODE above), else every process - each build
    # worker, each pytest worker - compiles build123d, numpy ... anew on import. Not a [tool.uv] setting: uv would then
    # re-check every file of the venv on every `uv run` (docs/toolchain.md Gotchas).
    uv sync --compile-bytecode
    # A venv that ever held cadquery-ocp (cadgen 0.5.x's VTK build) loses OCP/ when uv removes it: both
    # distributions own the same files and uv still counts cadquery-ocp-novtk as installed. Probe a
    # submodule: the hollowed-out OCP/ directory still imports, as an empty namespace package.
    if ! uv run --frozen python -c "import OCP.gp" 2>/dev/null; then
      echo "cadtool: the OCP kernel does not import - reinstalling cadquery-ocp-novtk" >&2
      uv sync --compile-bytecode --reinstall-package cadquery-ocp-novtk
    fi
    install_git_hook
    fetch_git_notes
    # The stored choice, per machine (cadgen's state directory); local only while no install id was ever made.
    uv run --frozen cadgen telemetry off >/dev/null && echo "cadtool: cadgen telemetry off (stored)" ;;
  python)
    exec uv run --frozen python "$@" ;;
  pytest)
    exec uv run --frozen pytest "$@" ;;
  lint)
    exec uv run --frozen ruff check "$@" ;;
  clean)
    # Regenerable caches only; --all also drops the git-ignored review artifacts. Never touches .venv,
    # the part STEPs, the committed reference/vendor/mesh files or cadgen's document cache (`./cadtool cadgen delete`).
    find "$CAD_DIR" -name .venv -prune -o -type d \( -name __cadgen__ -o -name __pycache__ -o -name .pytest_cache -o -name .ruff_cache \) -prune -print -exec rm -rf {} +
    if [[ "${1:-}" == "--all" ]]; then
      [[ -d snapshots ]] && find snapshots -mindepth 1 -prune -exec rm -rf {} +
      [[ -d print ]] && find print -mindepth 1 -prune -exec rm -rf {} +
      rm -f assemblies/*.step robot/links/*.step
    fi ;;
  help|-h|--help)
    usage ;;
  *)
    echo "cadtool: unknown command '$cmd'" >&2
    usage >&2
    exit 2 ;;
esac
