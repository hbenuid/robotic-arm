#!/usr/bin/env bash
# cadtool - the one entry point for cad/: the cad toolchain (a model is a plain script you RUN: the
# machine's one cad server builds it in a worker of THIS venv's Python and writes the file its @step declares;
# every other verb is that server's `cad` command, which uv installs at this project's pin) plus the usual dev
# commands, all inside THIS uv project (Python 3.14 + build123d + the cad library), always from cad/ with
# PYTHONPATH=cad/ so `lib`, `parts`, `assemblies` and `robot` import the same way for you and for the workers.
# Only `skill` and `doctor` need the text-to-cad@earthtojake plugin itself (CAD_PLUGIN=<dir> overrides
# its auto-detection).
set -euo pipefail

usage() {
  cat <<'USAGE'
cadtool - cad + this uv project (paths relative to cad/)
  ./cadtool setup                                   per machine: uv sync, bytecode compiled (+ the OCP kernel check) + the git pre-commit hook (ruff)
                                                    + git notes fetching + ./cadtool server
  ./cadtool server                                  the machine's cad-server at this project's pin, telemetry and automatic updates
                                                    stored off first, then `cad doctor`
                                                    (a linked worktree only checks it: a branch never moves the machine)
  ./cadtool doctor                                  the venv's, the server's and the plugin's release vs the pin, the stored telemetry
                                                    and automatic-update choices, the OCP kernel
  ./cadtool gen <model.py>... [--force]             build: run the model script(s) -> the sibling <name>.step (an assembly's
                                                    children write theirs too); a current one says "took ... nothing ran" and
                                                    keeps its file; --force runs every kernel call again (CAD_ENGINE_MEMO=0)
  ./cadtool step ...                                alias of gen
  ./cadtool inspect <file.step> [--planes] [--json] every leaf's ref, solids, faces, volume, bbox of a saved STEP
                                                    (--planes: + every planar face as normal / offset / area)
  ./cadtool inspect diff <a.step> <b.step> [--tol X] same geometry? (exit 1 if not) - a LOCAL tool, tools/step_facts.py
  ./cadtool cad step inspect <file.step> ["<ref>"]  what a document holds, or what one ref names (the server's own;
                                                    a document id: cad model inspect <id>)
  ./cadtool snapshot <file.step|.urdf|.sdf|.stl|id> <out.png> [--size-profile assembly --camera iso --display ... --job job.json]
                                                    the path you name is the file you get; cad's document type from
                                                    the file's suffix (cad step snapshot, cad urdf snapshot ...)
  ./cadtool export <file.step> stl|3mf|glb [out]    one mesh file per call (default: <file>.<format> beside it)
  ./cadtool validate <file.urdf|.srdf|.sdf> [--strict] [--gz-check never]
  ./cadtool viewer [file|id ...]                    the server opens each on its page, /<id> (default assemblies/arm.step);
                                                    the link printed is good for a day
  ./cadtool status                                  the machine's server: every session's workers, the documents it holds, its port, its cache
  ./cadtool stop                                    end THIS venv's idle workers, no other session's (the next gen starts a fresh one):
                                                    after a pyproject.toml / uv.lock change, and when leaving a worktree
  ./cadtool stop --device                           stop the whole server, for EVERY session on this machine
  ./cadtool skill <skill> <tool> [args]             a plugin skill script: skills/<skill>/scripts/<tool>
                                                    (+ the skill's requirements.txt, unlocked, in uv's cache)
  ./cadtool cad ...                                 any `cad` subcommand (`./cadtool cad --help`) but setup, update, uninstall, doctor, run
                                                    (printability: ./cadtool cad stl dfm print/<name>.stl --process printing)
  ./cadtool pytest [-m "not slow"] [-n 4]           test suite (-n: worker processes, a whole test file each)
  ./cadtool lint [--fix] [path...]                  ruff check (lint only, no formatter; rules: pyproject.toml [tool.ruff])
  ./cadtool python -m assemblies.arm ...            any python in the venv (PYTHONPATH=cad/)
  ./cadtool clean [--all]                           delete __pycache__/, .pytest_cache/, .ruff_cache/ (and any stray __cadgen__/);
                                                    --all also empties snapshots/ and print/ and deletes
                                                    assemblies/*.step, robot/links/*.step
Retired (each says what replaced it): why, compile, store, daemon, cadgen, parts.
Env: CAD_PLUGIN=<plugin dir> overrides detection. The document cache: ~/.cache/cad/documents
     (CAD_CACHE_DIR moves it; ./cadtool cad delete <id> --yes removes one).
USAGE
}

CAD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$CAD_DIR"   # cad resolves targets from cwd
export PYTHONPATH="$CAD_DIR${PYTHONPATH:+:$PYTHONPATH}"
# No __pycache__/ written into the tree (pytest importing every part would leave one in each group folder).
export PYTHONDONTWRITEBYTECODE=1
# cad sends usage stats and crash reports by default once a cad command has shown its notice; this repo keeps them
# off. In the environment, no cadtool command shows the notice or sends anything; `server` also stores the "off" that
# the server and the plugin go by: the environment never reaches them.
export CAD_TELEMETRY=0

pin() { sed -n 's/^ *"cad\[build123d\]==\([^"]*\)".*/\1/p' "$CAD_DIR/pyproject.toml"; }  # the toolchain's one pin
venv_cad() { uv run --frozen python -c "from importlib.metadata import version; print(version('cad'))" 2>/dev/null; }
cad_bin() { echo "$(uv tool dir --bin)/cad"; }

doc_type() {  # cad's document type of a file (`cad <type> <operation> FILE`), from its suffix; else a document id
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    *.step|*.stp) echo step ;;
    *.stl) echo stl ;;
    *.glb) echo glb ;;
    *.3mf) echo threemf ;;
    *.xbf) echo xbf ;;
    *.dxf) echo dxf ;;
    *.urdf) echo urdf ;;
    *.srdf) echo srdf ;;
    *.sdf) echo sdf ;;
    *) echo model ;;
  esac
}

server_release() {  # the cad-server uv installed, from its receipt: reading it runs nothing of cad, so tells no notice
  sed -n 's/.*name = "cad-server", specifier = "==\([^"]*\)".*/\1/p' "$(uv tool dir)/cad-server/uv-receipt.toml" 2>/dev/null
}

need_server() {
  local have want
  have="$(server_release || true)"; want="$(pin)"
  if [[ "$have" != "$want" ]]; then
    echo "cadtool: cad-server ${have:-is not installed}, this checkout pins $want - ./cadtool setup (docs/toolchain.md)" >&2
    exit 1
  fi
}

plugin_dir() {  # the plugin cache entry of the pin, else the newest (warned)
  local cache="$HOME/.claude/plugins/cache/earthtojake/text-to-cad" ver newest
  ver="$(pin)"
  if [[ -n "$ver" && -d "$cache/$ver" ]]; then echo "$cache/$ver"; return; fi
  newest="$(ls -d "$cache"/*/ 2>/dev/null | sort -V | tail -1 || true)"; newest="${newest%/}"
  [[ -n "$newest" ]] && echo "cadtool: warning: no plugin cache for cad ${ver:-?}; using $newest" >&2
  echo "$newest"
}

plugin_entries() {  # the releases of every installed text-to-cad@earthtojake entry (user, project, each checkout)
  uv run --frozen python -c '
import json, pathlib
path = pathlib.Path.home() / ".claude/plugins/installed_plugins.json"
entries = json.loads(path.read_text())["plugins"].get("text-to-cad@earthtojake", []) if path.exists() else []
print(" ".join(sorted({entry["version"] for entry in entries})))' 2>/dev/null
}

CAD_PLUGIN="${CAD_PLUGIN:-}"
need_plugin() {
  [[ -n "$CAD_PLUGIN" ]] || CAD_PLUGIN="$(plugin_dir)"
  if [[ -z "$CAD_PLUGIN" || ! -d "$CAD_PLUGIN/skills" ]]; then
    echo "cadtool: text-to-cad@earthtojake plugin not found under ~/.claude/plugins/cache/earthtojake" >&2
    echo "  install:  claude plugin marketplace add https://github.com/earthtojake/text-to-cad.git" >&2
    echo "            claude plugin install text-to-cad@earthtojake" >&2
    echo "  (a machine with the old cad@text-to-cad switches once: docs/toolchain.md Gotchas)" >&2
    exit 1
  fi
}

run_skill() {  # run_skill <skill> <tool> [args...]  ->  python skills/<skill>/scripts/<tool> args
  local skill="$1" tool="$2"; shift 2
  need_plugin
  local target="$CAD_PLUGIN/skills/$skill/scripts/$tool"
  if [[ ! -e "$target" ]]; then
    echo "cadtool: no such plugin tool: $target" >&2
    exit 1
  fi
  # The skill's own libraries, if it lists any in a requirements.txt, ride in uv's cached overlay for
  # this run, never in this project's lock. A requirements file that pins cad is left out: this venv's cad IS
  # that pin (`./cadtool doctor`), and resolving it afresh could pull a second cad + kernel.
  local reqs="$CAD_PLUGIN/skills/$skill/requirements.txt" with=()
  if [[ -f "$reqs" ]] && ! grep -Eq '^(cad|cadgen|cad-server)([^a-z-]|$)' "$reqs"; then with=(--with-requirements "$reqs"); fi
  exec uv run --frozen ${with[@]+"${with[@]}"} python "$target" "$@"
}

cg() {  # the machine's pinned `cad`. Refused: what would move the machine off the pin, and `run`, which builds in the
  # server's own environment instead of this venv (docs/toolchain.md Gotchas).
  case "${1:-}" in
    setup|update|uninstall|doctor|run)
      echo "cadtool: 'cad $1' is not run here - ./cadtool setup / server / doctor / gen (docs/toolchain.md Gotchas)" >&2
      exit 2 ;;
  esac
  need_server
  exec "$(cad_bin)" "$@"
}

install_server() {  # the machine's cad at the pin: telemetry off before anything else of cad runs, then `cad doctor`
  local want had cad
  want="$(pin)"; had="$(server_release || true)"; cad="$(cad_bin)"
  if [[ -f "$CAD_DIR/../.git" && -z "${CAD_STATE_DIR:-}" ]]; then  # a linked worktree: .git is a file
    if [[ "$had" == "$want" ]]; then echo "cadtool: cad-server $had, the pin"; return 0; fi
    echo "cadtool: cad-server ${had:-is not installed}, this worktree pins $want: a branch never moves the machine (docs/toolchain.md Testing a bump)" >&2
    return 1
  fi
  if [[ "$had" != "$want" ]]; then
    uv tool install --force --managed-python --python "$(cat "$CAD_DIR/.python-version")" "cad-server==$want"
  fi
  # The stored choices, per machine: what the server and the plugin go by. Off first: `cad doctor` starts the server.
  # Automatic updates (cad 0.11) would install a newer release by itself and move every agent app's plugin to it.
  "$cad" telemetry off >/dev/null && echo "cadtool: cad telemetry off (stored)"
  "$cad" update auto off >/dev/null && echo "cadtool: cad automatic updates off (stored)"
  "$cad" doctor
  # The running server keeps the release it started with: the next client starts the pin's.
  if [[ -n "$had" && "$had" != "$want" ]]; then "$cad" stop; fi
}

install_git_hook() {  # .git/hooks/pre-commit = a stub that runs the committed ../.githooks/pre-commit (ruff on the staged
  # .py files).
  local hooks stub marker="installed by cad/cadtool setup"
  hooks="$(git rev-parse --git-path hooks)" || return 0
  stub="$hooks/pre-commit"
  if [[ -e "$stub" ]] && ! grep -q "$marker" "$stub"; then
    echo "cadtool: $stub exists and is not ours - left alone (the ruff pre-commit hook is NOT installed)" >&2
    return 0
  fi
  mkdir -p "$hooks"
  printf '%s\n' '#!/bin/sh' "# $marker: the hook itself is the committed .githooks/pre-commit" \
    'exec bash "$(git rev-parse --show-toplevel)/.githooks/pre-commit" "$@"' > "$stub"
  chmod +x "$stub"
  echo "cadtool: git pre-commit hook installed ($stub -> .githooks/pre-commit)"
}

fetch_git_notes() {  # the retired CHANGELOG.md lives on as git notes (refs/notes/commits) - `git log` shows them.
  # Notes are not fetched by default: add the refspec once per machine. Not forced (+): a divergent notes ref fails the
  # fetch loudly instead of silently replacing local notes.
  local spec='refs/notes/*:refs/notes/*' have
  have="$(git config --get-all remote.origin.fetch 2>/dev/null || true)"
  case "$have" in *"$spec"*) return 0 ;; esac
  git config --add remote.origin.fetch "$spec" || return 0
  git fetch --quiet origin || echo "cadtool: git fetch of the notes failed - run 'git fetch origin' by hand" >&2
  echo "cadtool: git notes now come with every fetch / pull (remote.origin.fetch += $spec)"
}

cmd="${1:-help}"
shift || true
case "$cmd" in
  gen|step)
    # A model run takes no options: --force is the engine's no-memo switch, any other flag is refused here. The switch
    # goes with the run's environment, which the server hands the worker with every build.
    files=(); force=0
    for a in "$@"; do
      case "$a" in
        *.py) files+=("$a") ;;
        --force) force=1 ;;
        *) echo "cadtool gen: '$a' - a model run takes no options (--force: CAD_ENGINE_MEMO=0)" >&2; exit 2 ;;
      esac
    done
    if [[ ${#files[@]} -eq 0 ]]; then echo "usage: cadtool gen <model.py>... [--force]" >&2; exit 2; fi
    need_server
    if [[ $force -eq 1 ]]; then export CAD_ENGINE_MEMO=0; fi
    for f in "${files[@]}"; do uv run --frozen python "$f"; done ;;
  why|compile|store|daemon|cadgen|parts)
    case "$cmd" in
      why) said="no staleness check: run the model (./cadtool gen) - 'took ... nothing ran' is current, 'rebuilt: ...' says what changed" ;;
      compile) said="nothing to compile: the engine reads a STEP as it is" ;;
      store) said="no store: ./cadtool status (the server, its documents, its cache), ./cadtool cad delete <id> --yes" ;;
      daemon) said="one server per computer: ./cadtool status, ./cadtool stop" ;;
      parts) said="cad 0.11 retired the plugin's step-parts skill: step.parts by hand, vendor/AGENTS.md Recipe D" ;;
      *) said="the command is cad now: ./cadtool cad <verb>" ;;
    esac
    echo "cadtool $cmd: retired - $said" >&2; exit 2 ;;
  inspect)
    exec uv run --frozen python tools/step_facts.py "$@" ;;
  snapshot)
    case "${1:-}" in
      ""|-*) echo "usage: cadtool snapshot <file|id> <out.png> [options] - the file first: it names cad's document type" >&2; exit 2 ;;
    esac
    cg "$(doc_type "$1")" snapshot "$@" ;;
  export)
    doc="${1:?usage: cadtool export <file.step> stl|3mf|glb [out]}"; fmt="${2:?usage: cadtool export <file.step> stl|3mf|glb [out]}"; shift 2
    case "$fmt" in stl|3mf|glb) ;; *) echo "cadtool: export format must be stl|3mf|glb (got '$fmt')" >&2; exit 2 ;; esac
    cg "$(doc_type "$doc")" export "$doc" "${1:-${doc%.*}.$fmt}" ;;
  validate)
    file="${1:-}"
    case "$file" in
      *.urdf) cg urdf validate "$@" ;;
      *.srdf) cg srdf validate "$@" ;;
      *.sdf)  cg sdf validate "$@" ;;
      *) echo "usage: cadtool validate <file.urdf|.srdf|.sdf> [--strict] [--gz-check never] [--json]" >&2; exit 2 ;;
    esac ;;
  viewer)
    # The machine's server (started when none runs) registers each file / document id and opens its page, /<id>; the
    # printed link is good for a day.
    if [[ $# -eq 0 ]]; then set -- assemblies/arm.step; fi
    cg viewer "$@" ;;
  status)
    cg status "$@" ;;
  stop)
    # `cad stop` stops the server for every session on the machine, so that takes --device; the server has no verb for
    # one environment, so plain stop ends this venv's idle workers by their pid (tools/stop_workers.py).
    if [[ "${1:-}" == "--device" ]]; then shift; cg stop "$@"; fi
    need_server
    "$(cad_bin)" status --json | uv run --frozen python tools/stop_workers.py ;;
  cad)
    cg "$@" ;;
  server)
    install_server ;;
  skill)
    skill="${1:?usage: cadtool skill <skill> <tool> [args]}"; tool="${2:?usage: cadtool skill <skill> <tool> [args]}"; shift 2
    run_skill "$skill" "$tool" "$@" ;;
  doctor)
    # Changes nothing, so never `cad doctor`, which registers an installation and starts the server (./cadtool server
    # runs it). Every release against the pin, and the stored telemetry and automatic-update choices with the
    # environment's switches taken off: a switch reads "off" with no choice stored at all, and it never reaches the
    # server.
    rc=0
    need_plugin
    want="$(pin)"
    said() {  # said <what> <have>
      if [[ "$2" == "$want" ]]; then echo "$1: $2, the pin"
      else echo "$1: ${2:-none}, the pin is $want - MISMATCH, docs/toolchain.md Pins"; rc=1; fi
    }
    said "cad in the venv" "$(venv_cad || true)"
    said "cad-server on this machine" "$(server_release || true)"
    plugin="$(grep -o -m1 'cad-mcp==[0-9][0-9.]*' "$CAD_PLUGIN/claude.mcp.json" || true)"
    said "the plugin's pin ($CAD_PLUGIN)" "${plugin#cad-mcp==}"
    said "the installed plugin entries" "$(plugin_entries || true)"
    told="$(env -u CAD_TELEMETRY -u DO_NOT_TRACK "$(cad_bin)" telemetry status 2>/dev/null | head -1 || true)"
    case "$told" in
      *"off: your choice"*) echo "telemetry: off, stored" ;;
      *) echo "telemetry: '${told:-no answer}' - NOT stored off, run ./cadtool server"; rc=1 ;;
    esac
    # Asked of the pinned server only: an older one has no `update auto` and could read it as `cad update`.
    if [[ "$(server_release || true)" == "$want" ]]; then
      auto="$(env -u CAD_UPDATE_CHECK -u CI "$(cad_bin)" update auto status 2>/dev/null | head -1 || true)"
      case "$auto" in
        *"off (your choice)"*) echo "automatic updates: off, stored" ;;
        *) echo "automatic updates: '${auto:-no answer}' - NOT stored off, run ./cadtool server"; rc=1 ;;
      esac
    else
      echo "automatic updates: not asked - the server is not the pin"
    fi
    if uv run --frozen python -c "import OCP.gp" 2>/dev/null; then echo "kernel: OCP imports"
    else echo "kernel: OCP.gp does not import - run ./cadtool setup"; rc=1; fi
    "$(cad_bin)" status 2>&1 | head -1 || true
    exit $rc ;;
  setup)
    # Bytecode compiled into .venv (never into cad/: PYTHONDONTWRITEBYTECODE above), else every process - each build
    # worker, each pytest worker - compiles build123d, numpy ... anew on import. Not a [tool.uv] setting: uv would then
    # re-check every file of the venv on every `uv run` (docs/toolchain.md Gotchas).
    uv sync --compile-bytecode
    # A venv that ever held cadquery-ocp (cadgen 0.5.x's VTK build) loses OCP/ when uv removes it: both
    # distributions own the same files and uv still counts cadquery-ocp-novtk as installed. Probe a
    # submodule: the hollowed-out OCP/ directory still imports, as an empty namespace package.
    if ! uv run --frozen python -c "import OCP.gp" 2>/dev/null; then
      echo "cadtool: the OCP kernel does not import - reinstalling cadquery-ocp-novtk" >&2
      uv sync --compile-bytecode --reinstall-package cadquery-ocp-novtk
    fi
    install_git_hook
    fetch_git_notes
    install_server ;;
  python)
    exec uv run --frozen python "$@" ;;
  pytest)
    exec uv run --frozen pytest "$@" ;;
  lint)
    exec uv run --frozen ruff check "$@" ;;
  clean)
    # Regenerable caches only; --all also drops the git-ignored review artifacts. Never touches .venv,
    # the part STEPs, the committed reference/vendor/mesh files or the document cache (`./cadtool cad delete`).
    find "$CAD_DIR" -name .venv -prune -o -type d \( -name __cadgen__ -o -name __pycache__ -o -name .pytest_cache -o -name .ruff_cache \) -prune -print -exec rm -rf {} +
    if [[ "${1:-}" == "--all" ]]; then
      [[ -d snapshots ]] && find snapshots -mindepth 1 -prune -exec rm -rf {} +
      [[ -d print ]] && find print -mindepth 1 -prune -exec rm -rf {} +
      rm -f assemblies/*.step robot/links/*.step
    fi ;;
  help|-h|--help)
    usage ;;
  *)
    echo "cadtool: unknown command '$cmd'" >&2
    usage >&2
    exit 2 ;;
esac
