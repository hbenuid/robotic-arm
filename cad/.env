# Import root for the VS Code Python extension (Ctrl+F5 / the test explorer read this file):
# the cadgen model scripts import `lib`, `parts`, `assemblies`, `robot` from cad/ - cadtool
# exports the same PYTHONPATH; pytest gets it from pyproject.toml (pythonpath = ["."]).
PYTHONPATH=.
# No __pycache__/ in the tree, as cadtool: a __pycache__/ appearing in a parts/ group folder reads every model stale
# (cadgen hashes the folders parts._scan() lists by their entry names).
PYTHONDONTWRITEBYTECODE=1
