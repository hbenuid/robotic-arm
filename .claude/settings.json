{
  "extraKnownMarketplaces": {
    "earthtojake": {
      "source": {
        "source": "github",
        "repo": "earthtojake/text-to-cad",
        "ref": "latest"
      }
    }
  },
  "enabledPlugins": {
    "text-to-cad@earthtojake": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git -C \"${CLAUDE_PROJECT_DIR:-.}\" rev-parse --show-toplevel)/.claude/hooks/ruff-check.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
