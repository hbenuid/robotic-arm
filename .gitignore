.DS_Store
.venv/
__pycache__/
*.pyc

# --- Python tooling ---
.pytest_cache/
*.egg-info/

# --- CAD (cad/ is its own uv project; see cad/README.md) ---
# Meshes and STEPs are regenerated from the .py source - never committed.
*.stl
*.stp
*.3mf
*.glb
*.step
# EXCEPT: each part's primary STEP beside its model source (cadgen writes it there), purchased-part
# vendor STEPs, and the reference exports (none regenerable from Python). These committed
# STEP/STL files are Git LFS objects (see /.gitattributes): clone with git-lfs installed.
!/cad/parts/**/*.step
!/cad/vendor/*.step
!/cad/reference/**/*.step
# per-link meshes of the robot description (URDF/SDF reference them; regenerable with
# cad/tools/robot/export_link_meshes.py but committed so the URDF is usable on its own)
!/cad/robot/meshes/*.stl
# Snapshot PNGs / packets - regenerable.
/cad/snapshots/

# --- Claude Code ---
# Share project-scoped config (.claude/settings.json); keep local overrides out.
**/.claude/settings.local.json
**/.claude/worktrees/
