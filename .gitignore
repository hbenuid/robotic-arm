.DS_Store
.venv/
__pycache__/
*.pyc

# --- Python tooling ---
.pytest_cache/
*.egg-info/

# --- CAD (cad/ is its own uv project; see cad/README.md) ---
# Meshes and STEPs are regenerated from the .py source - never committed. That includes each part's
# STEP beside its model (cad/parts/<group>/<name>.step): `./cadtool gen` writes it, and its bytes differ
# per machine (float noise), so a committed copy would be rewritten by every other machine's build.
*.stl
*.stp
*.3mf
*.glb
*.step
# ... and their uppercase spellings (git matches case-sensitively; SolidWorks exports as .STEP). Nothing in
# the tree is ever uppercase - a dropped export belongs OUTSIDE the repo (root CLAUDE.md "The SolidWorks
# inputs are in the repo", cad/reference/README.md) - so these only stop one from slipping in as a raw blob.
*.STL
*.STP
*.STEP
# EXCEPT the INPUTS, none regenerable from Python: purchased-part vendor STEPs and the reference
# exports. These committed STEP/STL files are Git LFS objects (see /.gitattributes): clone with
# git-lfs installed.
!/cad/vendor/*.step
!/cad/reference/**/*.step
# per-link meshes of the robot description (URDF/SDF reference them; regenerable with
# cad/tools/robot/export_link_meshes.py but committed so the URDF is usable on its own)
!/cad/robot/meshes/*.stl
# Snapshot PNGs / packets - regenerable.
/cad/snapshots/

# --- Claude Code ---
# Share project-scoped config (.claude/settings.json); keep local overrides out.
**/.claude/settings.local.json
**/.claude/worktrees/
