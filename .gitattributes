# Line endings: the bash scripts stay LF on every checkout (Git for Windows defaults to core.autocrlf=true, and a
# CRLF bash script fails on its first line); the Windows launcher is CRLF. The index holds LF either way.
*.sh          text eol=lf
cad/cadtool   text eol=lf
.githooks/*   text eol=lf
*.bat         text eol=crlf
